  precio: { marginTop: spacing.md, fontSize: 18, fontWeight: '800', color: colors.primario },
  precioBarra: { fontSize: 18, fontWeight: '800', color: colors.primario },
  botonReserva: {
    backgroundColor: colors.primario,
    borderRadius: radius.full,
